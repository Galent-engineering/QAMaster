{
  "description": "Block git push until QAMaster's verdict for HEAD passes, in repos set up with qam setup --entry claude-code",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-push.mts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
