 {
  "id": "TC-TODO-001",
  "title": "Adding a todo with a title from the Add todo dialog",
  "component": "Todo",
  "type": "Functional",
  "category": "Positive",
  "priority": "P1",
  "severity": "High",
  "sub_module": "AUT_Todo-Todo",
  "feature": "Todo",
  "channel": "Web",
  "coverage": [
   "Functional"
  ],
  "session": "signed-in",
  "objective": "Add a todo through the Add todo dialog",
  "preconditions": [],
  "test_data": {
   "title": "Buy milk"
  },
  "steps": [
   {
    "screen": "/todo",
    "action": "Click the Add todo button",
    "element": "Add todo",
    "expected": "The Add todo dialog opens with its Title field",
    "evidence": [
     "dsm:element:/todo:Add todo"
    ]
   },
   {
    "screen": "/todo",
    "action": "Fill the Title field",
    "element": "Title",
    "expected": "The Title field shows Buy milk",
    "evidence": [
     "dsm:element:/todo:Title"
    ],
    "data": "Buy milk"
   },
   {
    "screen": "/todo",
    "action": "Click the Save button",
    "element": "Save",
    "expected": "The new todo Buy milk is listed",
    "evidence": [
     "dsm:element:/todo:Save"
    ]
   }
  ],
  "expected_result": "The todo Buy milk is listed on the /todo screen",
  "evidence": [
   "aut:AUT_Todo-Todo#Screen details"
  ]
 },
