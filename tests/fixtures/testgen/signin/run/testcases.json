[
 {
  "id": "TC-AUTH-001",
  "title": "Signing in with the registered account opens the Todo screen",
  "component": "Auth",
  "type": "Functional",
  "category": "Positive",
  "priority": "P1",
  "severity": "High",
  "sub_module": "AUT_Todo-Auth",
  "feature": "Login",
  "channel": "Web",
  "coverage": [
   "Functional"
  ],
  "session": "signed-out",
  "objective": "Sign in with the registered user's email and password",
  "preconditions": [],
  "test_data": {
   "account": "the registered user"
  },
  "steps": [
   {
    "screen": "/login",
    "action": "Fill the Email field",
    "element": "Email",
    "expected": "The Email field shows the registered user's email",
    "evidence": [
     "dsm:element:/login:Email"
    ],
    "data": "the registered user's email"
   },
   {
    "screen": "/login",
    "action": "Fill the Password field",
    "element": "Password",
    "expected": "The Password field is filled",
    "evidence": [
     "dsm:element:/login:Password"
    ],
    "data": "the registered user's password"
   },
   {
    "screen": "/login",
    "action": "Click the Sign in button",
    "element": "Sign in",
    "expected": "The /todo screen opens",
    "evidence": [
     "dsm:relation:/login->/todo"
    ],
    "leads_to": "/todo"
   }
  ],
  "expected_result": "The /todo screen opens for the registered user",
  "evidence": [
   "aut:AUT_Todo-Auth#Screen details"
  ]
 },
